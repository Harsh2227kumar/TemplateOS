# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Backend
APP_NAME=TemplateOS API
APP_ENV=development
# Never true in production (APP_ENV=production refuses to start with it).
APP_DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# APP_ENV=production refuses to start with this placeholder or < 32 chars.
JWT_SECRET_KEY=generate-a-long-random-secret-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Uploaded/processed files. Relative paths resolve against the repository root.
STORAGE_BASE_PATH=backend/storage

# AI — AWS Bedrock (backend-only).
# - POST /api/v1/templates/{id}/suggest-fields (V1.3): Claude Sonnet via
#   AnthropicBedrock + instructor-validated structured output.
# - POST /api/v1/ai/improve-text (V1.5): Amazon Nova Micro/Lite via the
#   Bedrock Converse API (boto3 + instructor).
#
# On/off: AI is enabled when AWS_REGION is set AND auth resolves
# (AWS_BEARER_TOKEN_BEDROCK API key or AWS IAM credentials).
# Leave AWS_REGION unset (default) to keep AI off — the endpoint returns 503
# and the manual Phase 3 field editor keeps working (graceful degradation).
# AWS_REGION=ap-south-1
#
# Model routing — REQUIRED whenever AWS_REGION is set (no default in code).
# Claude models are invoked via inference-profile ids (e.g. apac.anthropic...
# for older models, global.anthropic... for Sonnet 4.5+). Copy the exact id
# from the Bedrock console -> Model access -> model details.
# Example for ap-south-1 (Claude Sonnet 4.5):
# BEDROCK_MODEL_SUGGESTIONS=global.anthropic.claude-sonnet-4-5-20250929-v1:0
#
# V1.5 text actions (improve-text) — REQUIRED for those actions when
# AWS_REGION is set. Nova Micro: "grammar"; Nova Lite: "tone", "concise",
# "formal". In ap-south-1 use the APAC inference-profile ids, e.g.:
# BEDROCK_MODEL_NOVA_MICRO=apac.amazon.nova-micro-v1:0
# BEDROCK_MODEL_NOVA_LITE=apac.amazon.nova-lite-v1:0
#
# Max tokens for the model's reply (validation + suggestions).
# AI_MAX_OUTPUT_TOKENS=1024
#
# Credentials (never passed in code):
#   AWS_BEARER_TOKEN_BEDROCK                             (Bedrock long-term API
#                                                        key — preferred)
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY            (long-lived keys)
#   AWS_SESSION_TOKEN                                    (optional, temporary creds)
# ...or a shared AWS profile / instance role via boto3's default chain.
# NEVER expose Bedrock credentials to the frontend — only FastAPI talks to
# Bedrock (standing project rule).

# TEMPORARY DEVELOPMENT USERS ONLY
# Remove this entire section and delete these database users before deployment.
# They are read only by `python scripts/seed_demo_users.py`. Pick your own
# passwords (min. 8 characters) in your local .env: anything committed here is
# public, so never seed these placeholder values into a shared database.

