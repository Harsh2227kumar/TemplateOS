# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Backend
APP_NAME=TemplateOS API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
JWT_SECRET_KEY=generate-a-long-random-secret-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI — AWS Bedrock via AnthropicBedrock (V1.3 Phase 4, backend-only).
# The ONLY AI feature so far: POST /api/v1/templates/{id}/suggest-fields
# (Claude Sonnet via instructor-validated structured output).
#
# On/off: AI is enabled when AWS_REGION is set AND AWS credentials resolve.
# Leave AWS_REGION unset (default) to keep AI off — the endpoint returns 503
# and the manual Phase 3 field editor keeps working (graceful degradation).
# AWS_REGION=ap-south-1
#
# Model routing: Claude models on Bedrock are often only invokable via a
# cross-region inference-profile id (e.g. us.anthropic.claude-3-5-sonnet-...:0).
# Verify the exact id in the team's AWS account (Bedrock console -> model access).
# BEDROCK_MODEL_SUGGESTIONS=anthropic.claude-3-5-sonnet-20241022-v2:0
#
# Max tokens for the model's reply (validation + suggestions).
# AI_MAX_OUTPUT_TOKENS=1024
#
# Credentials (standard AWS provider chain — never passed in code):
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY          (long-lived keys)
#   AWS_SESSION_TOKEN                                  (optional, temporary creds)
# ...or a shared AWS profile / instance role via boto3's default chain.
# NEVER expose Bedrock credentials to the frontend — only FastAPI talks to
# Bedrock (standing project rule).

# TEMPORARY DEVELOPMENT USERS ONLY
# Remove this entire section and delete these database users before deployment.
# These values are intentionally explicit for local role testing and are not
# read automatically by the application.

SIT_SUPER_ADMIN_EMAIL=super.admin@example.com
SIT_SUPER_ADMIN_PASSWORD=TempOS!Super2026

