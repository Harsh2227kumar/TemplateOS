# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Backend
APP_NAME=TemplateOS API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
JWT_SECRET_KEY=generate-a-long-random-secret-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI — AWS Bedrock via AnthropicBedrock (V1.3 Phase 4, backend-only).
# Leave AWS_REGION unset to keep AI features off (suggest-fields -> 503).
# AWS_REGION=ap-south-1
# BEDROCK_MODEL_SUGGESTIONS=anthropic.claude-3-5-sonnet-20241022-v2:0
# AI_MAX_OUTPUT_TOKENS=1024
# Credentials: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (env vars) or the
# default boto3 chain (shared profile / instance role). NEVER expose Bedrock
# credentials to the frontend — only FastAPI talks to Bedrock.

# TEMPORARY DEVELOPMENT USERS ONLY
# Remove this entire section and delete these database users before deployment.
# These values are intentionally explicit for local role testing and are not
# read automatically by the application.

SIT_SUPER_ADMIN_EMAIL=super.admin@example.com
SIT_SUPER_ADMIN_PASSWORD=TempOS!Super2026

SIT_ORG_ADMIN_EMAIL=org.admin@example.com
SIT_ORG_ADMIN_PASSWORD=TempOS!Org2026

SIT_DEPARTMENT_ADMIN_EMAIL=department.admin@example.com
SIT_DEPARTMENT_ADMIN_PASSWORD=TempOS!Dept2026

SIT_FACULTY_EMAIL=faculty@example.com
SIT_FACULTY_PASSWORD=TempOS!Faculty2026

SIT_STUDENT_EMAIL=student@example.com
SIT_STUDENT_PASSWORD=TempOS!Student2026

SIT_APPROVER_EMAIL=approver@example.com
