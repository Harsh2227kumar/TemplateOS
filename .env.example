# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Backend
APP_NAME=TemplateOS API
APP_ENV=development
# Never true in production (APP_ENV=production refuses to start with it).
APP_DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# APP_ENV=production refuses to start with this placeholder or < 32 chars.
JWT_SECRET_KEY=generate-a-long-random-secret-here
JWT_ALGORITHM=HS256
# Short-lived access JWT (httpOnly cookie `templateos_access`, or Bearer).
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Rotating refresh token (httpOnly cookie `templateos_refresh`, stored hashed).
REFRESH_TOKEN_EXPIRE_DAYS=7
# A refresh token rotated less than this many seconds ago returns 409 instead
# of triggering reuse detection (concurrent refreshes from several tabs).
REFRESH_REUSE_GRACE_SECONDS=30
# Secure cookie flag. Unset -> on when APP_ENV=production, off otherwise.
# COOKIE_SECURE=true
# Cookie Domain attribute. Unset (default) -> host-only cookies.
# COOKIE_DOMAIN=
# In-memory login throttling, per client IP and per email (per process).
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# Uploaded/processed files. Relative paths resolve against the repository root.
STORAGE_BASE_PATH=backend/storage

# PDF conversion (V1.6 Phase 2). DOCX generation always works; the PDF is
# converted right after it and a conversion failure never fails the DOCX
# (the document shows "PDF not available" with the reason and Retry PDF).
# Start Gotenberg with: docker compose up -d gotenberg   (repo-root compose file)
# Check it with:        python backend/scripts/verify_gotenberg.py --live
# .env is read at startup: restart the backend after changing it. The startup
# log names the converter in use; GET /api/v1/system/pdf-check tests it.
# Kill switch for machines without Docker/LibreOffice (PDF recorded as failed:
# "PDF conversion is disabled on this server").
PDF_CONVERSION_ENABLED=true
# The backend POSTs the DOCX to {GOTENBERG_URL}/forms/libreoffice/convert.
# Leave GOTENBERG_URL unset/empty to fall back to a local LibreOffice.
GOTENBERG_URL=http://localhost:3000
GOTENBERG_TIMEOUT_SECONDS=60
# PDF_CONVERTER: auto (default) | gotenberg | libreoffice | none
#   auto -> Gotenberg when GOTENBERG_URL is set, else a local LibreOffice
#           (LIBREOFFICE_PATH, or soffice/libreoffice on PATH), else PDF is
#           recorded as failed ("PDF conversion is not set up on this server").
#   none -> same as PDF_CONVERSION_ENABLED=false.
# PDF_CONVERTER=auto
# Local LibreOffice (headless soffice --convert-to pdf). Full path to the
# binary when it is not on PATH, e.g. on Windows:
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# LIBREOFFICE_TIMEOUT_SECONDS=120

# Document versions (V1.7): every Generate creates a new version. The
# DOCX/PDF files of versions older than the newest N are deleted from
# storage; their values stay viewable and restorable. Default 10, minimum 1.
# GENERATED_VERSIONS_KEEP_FILES=10

# Word file editor (V1.7 Phase 2.1): ONLYOFFICE Docs Community Edition (free,
# AGPL, run unmodified as its own container: docker compose up -d onlyoffice).
# Off by default; the "Edit Word file" / "Customize" buttons are hidden then.
# ONLYOFFICE_JWT_SECRET must equal the container's JWT_SECRET (32+ chars) and
# is never sent to the browser. The container reaches the backend through
# BACKEND_URL_FOR_ONLYOFFICE (host.docker.internal on Docker Desktop).
# ONLYOFFICE_ENABLED=false
# ONLYOFFICE_PUBLIC_URL=http://localhost:8082
# ONLYOFFICE_INTERNAL_URL=http://localhost:8082
# ONLYOFFICE_JWT_SECRET=generate-a-long-random-secret-for-onlyoffice
# BACKEND_URL_FOR_ONLYOFFICE=http://host.docker.internal:8000
# EDITOR_SESSION_TTL_MINUTES=240
# EDITOR_MAX_FILE_MB=20

# AI — AWS Bedrock (backend-only).
# - POST /api/v1/templates/{id}/suggest-fields (V1.3): Claude Sonnet via
#   AnthropicBedrock + instructor-validated structured output.
# - POST /api/v1/ai/improve-text (V1.5): Amazon Nova Micro/Lite via the
#   Bedrock Converse API (boto3 + instructor).
#
# On/off: AI is enabled when AWS_REGION is set AND auth resolves
# (AWS_BEARER_TOKEN_BEDROCK API key or AWS IAM credentials).
# Leave AWS_REGION unset (default) to keep AI off — the endpoint returns 503
# and the manual Phase 3 field editor keeps working (graceful degradation).
# AWS_REGION=ap-south-1
#
# Model routing — REQUIRED whenever AWS_REGION is set (no default in code).
# Claude models are invoked via inference-profile ids (e.g. apac.anthropic...
# for older models, global.anthropic... for Sonnet 4.5+). Copy the exact id
# from the Bedrock console -> Model access -> model details.
# Example for ap-south-1 (Claude Sonnet 4.5):
# BEDROCK_MODEL_SUGGESTIONS=global.anthropic.claude-sonnet-4-5-20250929-v1:0
#
# V1.5 text actions (improve-text) — REQUIRED for those actions when
# AWS_REGION is set. Nova Micro: "grammar"; Nova Lite: "tone", "concise",
# "formal". In ap-south-1 use the APAC inference-profile ids, e.g.:
# BEDROCK_MODEL_NOVA_MICRO=apac.amazon.nova-micro-v1:0
# BEDROCK_MODEL_NOVA_LITE=apac.amazon.nova-lite-v1:0
#
# Max tokens for the model's reply (validation + suggestions).
# AI_MAX_OUTPUT_TOKENS=1024
#
# Credentials (never passed in code):
#   AWS_BEARER_TOKEN_BEDROCK                             (Bedrock long-term API
#                                                        key — preferred)
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY            (long-lived keys)
#   AWS_SESSION_TOKEN                                    (optional, temporary creds)
# ...or a shared AWS profile / instance role via boto3's default chain.
# NEVER expose Bedrock credentials to the frontend — only FastAPI talks to
# Bedrock (standing project rule).

# TEMPORARY DEVELOPMENT USERS ONLY
# Remove this entire section and delete these database users before deployment.
# They are read only by `python scripts/seed_demo_users.py`. Pick your own
# passwords (min. 8 characters) in your local .env: anything committed here is
# public, so never seed these placeholder values into a shared database.

SIT_SUPER_ADMIN_EMAIL=super.admin@example.com
SIT_SUPER_ADMIN_PASSWORD=change-me-local-only

SIT_ORG_ADMIN_EMAIL=org.admin@example.com
SIT_ORG_ADMIN_PASSWORD=change-me-local-only

SIT_DEPARTMENT_ADMIN_EMAIL=department.admin@example.com
SIT_DEPARTMENT_ADMIN_PASSWORD=change-me-local-only

SIT_FACULTY_EMAIL=faculty@example.com
SIT_FACULTY_PASSWORD=change-me-local-only

SIT_STUDENT_EMAIL=student@example.com
SIT_STUDENT_PASSWORD=change-me-local-only

SIT_APPROVER_EMAIL=approver@example.com
SIT_APPROVER_PASSWORD=change-me-local-only

SIT_NORMAL_USER_EMAIL=normal.user@example.com
SIT_NORMAL_USER_PASSWORD=change-me-local-only
